+#pragma once
+
+// One spelling of "is this an Apple TV build" for code that must not depend on a
+// build-system definition (translated shards, tests and the runtime all include
+// guest_abi headers that branch on it).
+//
+// TargetConditionals.h defines every TARGET_OS_* macro, as 0 or 1, on all Apple
+// SDKs. TARGET_OS_TV is 1 for both the Apple TV device and the Apple TV
+// Simulator; TARGET_OS_IPHONE is also 1 there, so never use TARGET_OS_IPHONE
+// alone to mean "iPhone/iPad".
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+
+#if defined(__APPLE__) && defined(TARGET_OS_TV) && TARGET_OS_TV
+#define MKW_HOST_TVOS 1
+#else
+#define MKW_HOST_TVOS 0
+#endif
diff --git a/runtime/include/platform/tvos_app.h b/runtime/include/platform/tvos_app.h
new file mode 100644
index 0000000..8baf53d
--- /dev/null
+++ b/runtime/include/platform/tvos_app.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <exception>
+#include <string>
+
+// Apple TV process entry. A tvOS app has to run inside UIApplicationMain, so
+// main() hands control to UIKit through SDL_RunApp and the runtime starts once
+// the application has finished launching - on the main thread, as SDL, UIKit
+// and the guest scheduler all require.
+namespace RuntimeTvos {
+
+using EntryPoint = int (*)(int argc, char** argv);
+
+// Never returns while the app is running; returns the entry point's exit code
+// if it ever finishes.
+int RunApplication(int argc, char** argv, EntryPoint entry);
+
+// Name, reason and call stack of an Objective-C exception, or an empty string
+// when `exception` is not one (src/platform/tvos/objc_exception_tvos.mm).
+std::string DescribeObjCException(std::exception_ptr exception) noexcept;
+
+} // namespace RuntimeTvos
