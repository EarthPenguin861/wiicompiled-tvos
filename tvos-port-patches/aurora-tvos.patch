+      set(_aurora_dawn_patch_args
+        PATCH_COMMAND ${CMAKE_COMMAND} -DDAWN_SOURCE_DIR=<SOURCE_DIR> -P "${_aurora_dawn_tvos_patches}")
+    endif ()
     FetchContent_Declare(dawn
       URL "https://github.com/encounter/dawn/archive/${AURORA_DAWN_REF}.tar.gz"
